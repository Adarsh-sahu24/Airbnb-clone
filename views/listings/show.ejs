<% layout('/layouts/boilerplate.ejs') -%>
<script>
  const mapToken = '<%= process.env.MAP_TOKEN %>';
</script>
<script>
  const coordinates = <%- JSON.stringify(data.geometry.coordinates) %>
</script>

<div class="row  mt-3"></div>
  <div class="col-8 offset-3">
    
    <h3><%= data.title %></h3>
  </div>

  <div class="card col-6 offset-3 listing-card">
      <img src="<%= data.image.url %>" class="card-img-top show-img" alt="listing-image">
      
    <div class="card-body mt-3">
      <p class="card-text">
        <b><i><%= data.owner.username %></i></b>
      </p>
      <p class="card-text">
        &#8377; <%= data.price %> for 1 night 
        <br>
        <%= data.location %> , <%= data.country %> 
        <br>
        <br>
        <%= data.description %>
      </p>
      
      <% if(currUser && currUser._id.equals(data.owner._id)){ %>
        <div class="btns">
          <a href="/listings/<%= data._id %>/update" class="btn btn-primary" style="background-color: #ff385c; border: none;">Edit</a> 
          &nbsp;
          &nbsp;
          <form action="/listings/<%= data._id %>?_method=DELETE" method="post">
            <button class="btn btn-primary" style="background-color: #ff385c; border: none;">Delete</button>
          </form>
        </div>
      <% } %>

    </div>
  </div>

  

  <div class="card col-8 offset-3 listing-card">
    <% if(currUser){ %>
      <hr>
      
      <h4>Leave a Review</h4>
      <form action="/listings/<%= data._id %>/reviews" method="post" class="needs-validation" novalidate>
        <div class="col-6 offset-3">
          <!-- <h5>Rate Us</h5>
          <div class="star-rating">
            <input type="radio" id="star5" name="review[rating]" value="5" />
            <label for="star5">★</label>
            <input type="radio" id="star4" name="review[rating]" value="4" />
            <label for="star4">★</label>
            <input type="radio" id="star3" name="review[rating]" value="3" />
            <label for="star3">★</label>
            <input type="radio" id="star2" name="review[rating]" value="2" />
            <label for="star2">★</label>
            <input type="radio" id="star1" name="review[rating]" value="1" />
            <label for="star1">★</label>
          </div> -->
        

          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="col-6">
          <label for="comment">Comment</label>
          <textarea name="review[comment]" id="comment" cols="80" rows="5" required></textarea>
          <div class="invalid-feedback">"Review is required"</div>
          <div class="valid-feedback">"Thanks for your review !"</div>
        </div>
        <button class="btn btn-primary" style="background-color: #ff385c; border: none;">Submit</button>
      </form>

    <% } %>

    <hr>
    
    <% if(data.reviews && data.reviews.length ){ %>
        <h4>All Reviews</h4>
    <% } %>

    <div class="row">
      <% for(review of data.reviews){ %>
        <div class="card col-5 mb-3 ms-3">
            <div class="card-body">
              <h5 class="card-title"><%= review.author.username %></h5>
              <p class="card-text"><%= review.comment %></p>
                <p class="starability-result" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
                </p>
            </div>
            <% if(currUser && currUser._id.equals(review.author._id)){ %>
              <form action="/listings/<%= data._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="mb-2">
                <button class="btn btn-dark btn-sm">Delete</button>
              </form>
            <% } %>
        </div>
      <% } %>
    </div>
  </div>
  
  <div class="col-6 offset-3 mb-3">
    <h3>Where you'll be</h3>
    <div id="map"></div>
  </div>
  <script src="/js/map.js"></script>

</div>